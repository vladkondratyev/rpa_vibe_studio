{
  "name": "Вход на портал и выгрузка таблицы",
  "category": "Примеры",
  "description": "Открывает портал, входит под учётной записью робота (пароль — из хранилища секретов), забирает таблицу и сохраняет в Excel. При ошибке входа — скриншот.",
  "minutes_saved": 15,
  "tags": [
    "Web",
    "Excel"
  ],
  "requires": [],
  "definition": {
    "variables": [
      {
        "name": "портал",
        "default": "https://portal.example.com"
      },
      {
        "name": "логин",
        "default": "robot"
      },
      {
        "name": "файл",
        "default": "выгрузка.xlsx"
      }
    ],
    "outputs": [
      "строки"
    ],
    "nodes": [
      {
        "id": "start",
        "type": "core.start",
        "params": {},
        "position": {
          "x": 40,
          "y": 40
        }
      },
      {
        "id": "open",
        "type": "web.open",
        "label": "Открыть браузер",
        "params": {
          "url": "{{ портал }}/login",
          "headless": true
        },
        "position": {
          "x": 370,
          "y": 40
        }
      },
      {
        "id": "login",
        "type": "web.fill",
        "label": "Логин",
        "params": {
          "selector": "#username",
          "value": "{{ логин }}"
        },
        "position": {
          "x": 700,
          "y": 40
        }
      },
      {
        "id": "pwd",
        "type": "web.fill",
        "label": "Пароль",
        "params": {
          "selector": "#password",
          "value": "{{ secret('portal_password') }}"
        },
        "position": {
          "x": 1030,
          "y": 40
        }
      },
      {
        "id": "go",
        "type": "web.click",
        "label": "Войти",
        "params": {
          "selector": "role=button[name=\"Войти\"]"
        },
        "position": {
          "x": 1360,
          "y": 40
        }
      },
      {
        "id": "tbl",
        "type": "web.extract_table",
        "label": "Таблица",
        "params": {
          "selector": "table",
          "result": "строки"
        },
        "position": {
          "x": 370,
          "y": 210
        }
      },
      {
        "id": "book",
        "type": "excel.open",
        "label": "Книга",
        "params": {
          "path": "{{ файл }}",
          "book": "выгрузка",
          "create": true
        },
        "position": {
          "x": 700,
          "y": 210
        }
      },
      {
        "id": "w",
        "type": "excel.write_table",
        "label": "Записать",
        "params": {
          "book": "выгрузка",
          "sheet": "Данные",
          "rows": "строки"
        },
        "position": {
          "x": 1030,
          "y": 210
        }
      },
      {
        "id": "save",
        "type": "excel.save",
        "label": "Сохранить",
        "params": {
          "book": "выгрузка"
        },
        "position": {
          "x": 1360,
          "y": 210
        }
      },
      {
        "id": "shot",
        "type": "web.screenshot",
        "label": "Скриншот ошибки",
        "params": {
          "path": "ошибка_входа.png"
        },
        "position": {
          "x": 1360,
          "y": 380
        }
      },
      {
        "id": "close",
        "type": "web.close",
        "label": "Закрыть браузер",
        "params": {},
        "position": {
          "x": 1690,
          "y": 210
        }
      },
      {
        "id": "end",
        "type": "core.end",
        "label": "Готово",
        "params": {},
        "position": {
          "x": 2020,
          "y": 210
        }
      }
    ],
    "edges": [
      {
        "id": "e0",
        "source": "start",
        "sourceHandle": "out",
        "target": "open"
      },
      {
        "id": "e1",
        "source": "open",
        "sourceHandle": "out",
        "target": "login"
      },
      {
        "id": "e2",
        "source": "login",
        "sourceHandle": "out",
        "target": "pwd"
      },
      {
        "id": "e3",
        "source": "pwd",
        "sourceHandle": "out",
        "target": "go"
      },
      {
        "id": "e4",
        "source": "go",
        "sourceHandle": "out",
        "target": "tbl"
      },
      {
        "id": "e5",
        "source": "tbl",
        "sourceHandle": "out",
        "target": "book"
      },
      {
        "id": "e6",
        "source": "book",
        "sourceHandle": "out",
        "target": "w"
      },
      {
        "id": "e7",
        "source": "w",
        "sourceHandle": "out",
        "target": "save"
      },
      {
        "id": "e8",
        "source": "save",
        "sourceHandle": "out",
        "target": "close"
      },
      {
        "id": "e9",
        "source": "close",
        "sourceHandle": "out",
        "target": "end"
      },
      {
        "id": "e10",
        "source": "go",
        "sourceHandle": "error",
        "target": "shot"
      },
      {
        "id": "e11",
        "source": "shot",
        "sourceHandle": "out",
        "target": "close"
      }
    ]
  }
}
