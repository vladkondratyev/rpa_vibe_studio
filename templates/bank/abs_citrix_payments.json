          "text": "{{ item['data']['бик'] }}",
          "hotkey": "tab"
        },
        "position": {
          "x": 1030,
          "y": 210
        }
      },
      {
        "id": "sum",
        "type": "vision.click_text",
        "label": "Поле «Сумма»",
        "params": {
          "text": "Сумма",
          "offset": "160,0"
        },
        "position": {
          "x": 700,
          "y": 210
        }
      },
      {
        "id": "t3",
        "type": "vision.type",
        "label": "Ввести сумму",
        "params": {
          "text": "{{ '%.2f' % item['data']['сумма'] }}",
          "hotkey": "tab"
        },
        "position": {
          "x": 370,
          "y": 210
        }
      },
      {
        "id": "pur",
        "type": "vision.type",
        "label": "Назначение платежа",
        "params": {
          "text": "{{ item['data']['назначение'] }}"
        },
        "position": {
          "x": 370,
          "y": 380
        }
      },
      {
        "id": "save",
        "type": "vision.type",
        "label": "Сохранить (F2)",
        "params": {
          "hotkey": "f2"
        },
        "position": {
          "x": 700,
          "y": 380
        }
      },
      {
        "id": "w2",
        "type": "vision.wait_text",
        "label": "Документ сохранён",
        "params": {
