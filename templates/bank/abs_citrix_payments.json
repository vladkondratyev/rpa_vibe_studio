{
  "name": "Ввод платёжек в АБС через Citrix",
  "category": "Банк",
  "description": "Робот-исполнитель очереди: берёт платёж, в сессии Citrix открывает форму АБС, находит поля по надписям (OCR) и образцам кнопок, вводит реквизиты, сохраняет скриншот и закрывает элемент. При сбое элемент вернётся в очередь.",
  "minutes_saved": 6,
  "tags": [
    "Citrix",
    "АБС",
    "Vision",
    "очереди"
  ],
  "requires": [
    "Tesseract",
    "pyautogui",
    "OpenCV"
  ],
  "definition": {
    "variables": [],
    "outputs": [],
    "nodes": [
      {
        "id": "start",
        "type": "core.start",
        "params": {},
        "position": {
          "x": 40,
          "y": 40
        }
      },
      {
        "id": "act",
        "type": "desktop.activate",
        "label": "Окно Citrix",
        "params": {
          "window": "Citrix Workspace|АБС"
        },
        "position": {
          "x": 370,
          "y": 40
        }
      },
      {
        "id": "next",
