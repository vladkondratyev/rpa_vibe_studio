        },
        "position": {
          "x": 1030,
          "y": 380
        }
      },
      {
        "id": "shot",
        "type": "vision.screenshot",
        "label": "Скриншот",
        "params": {
          "name": "платёж_{{ item['id'] }}.png"
        },
        "position": {
          "x": 1360,
          "y": 380
        }
      },
      {
        "id": "done",
        "type": "queue.complete",
        "label": "Платёж введён",
        "params": {
          "item": "item"
        },
        "position": {
          "x": 1690,
          "y": 380
        }
      },
      {
        "id": "fail",
        "type": "queue.fail",
        "label": "Ошибка ввода",
        "params": {
          "item": "item",
          "error": "{{ last_error }}"
        },
        "position": {
          "x": 1030,
          "y": 550
        }
      },
      {
        "id": "esc",
        "type": "vision.type",
        "label": "Закрыть форму",
        "params": {
          "hotkey": "esc"
        },
        "position": {
          "x": 1360,
          "y": 550
        }
      },
      {
        "id": "end",
        "type": "core.end",
        "label": "Готово",
        "params": {},
        "position": {
          "x": 40,
          "y": 210
        }
      }
